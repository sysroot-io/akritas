# The image's built-in JSON config supplies container-safe address, upstream,
# and audit defaults. Secrets remain environment-only.
OPENAI_API_KEY=
AKRITAS_API_KEY=replace-with-a-long-random-value

# Optional strict JSON configuration mounted into the service/container.
# AKRITAS_CONFIG=/etc/akritas/server.json

# Every remaining serve option also has an environment override. Uncomment only
# values that should take precedence over the JSON configuration and defaults.
# AKRITAS_ADDRESS=0.0.0.0:8090
# AKRITAS_BASE_URL=http://host.docker.internal:8080/v1
# AKRITAS_UPSTREAM_MODEL=
# AKRITAS_MODEL=akritas
# AKRITAS_UPSTREAM_API_KEY_ENV=OPENAI_API_KEY
# AKRITAS_API_KEY_ENV=AKRITAS_API_KEY
# AKRITAS_SYSTEM_INSTRUCTIONS=instructions/SYSTEM.md
# AKRITAS_SKILLS_DIR=skills
# AKRITAS_RESPONSE_LANGUAGE=en
# AKRITAS_RAG_INDEX=
# AKRITAS_MCP_CONFIG=
# AKRITAS_NOTIFICATIONS_CONFIG=
# AKRITAS_ALERT_SOURCES_CONFIG=
# AKRITAS_ALERT_STORE=/var/lib/akritas/audit/alerts.jsonl
# AKRITAS_PUBLIC_URL=https://akritas.example
# Secrets referenced by configs/akritas/alerts.example.json.
# AKRITAS_ALERTMANAGER_TOKEN=
# AKRITAS_GENERIC_ALERT_TOKEN=
# AKRITAS_UPTIME_KUMA_WEBHOOK_TOKEN=
# AKRITAS_PINGDOM_WEBHOOK_TOKEN=
# AKRITAS_INCIDENT_WEBHOOK_URL=https://automation.example/hooks/akritas
# AKRITAS_INCIDENT_WEBHOOK_TOKEN=
# AKRITAS_INCIDENT_WEBHOOK_HMAC_SECRET=
# AKRITAS_TELEGRAM_BOT_TOKEN=
# AKRITAS_TELEGRAM_CHAT_ID=
# AKRITAS_TELEGRAM_THREAD_ID=
# Required only when the Telegram receiver uses inbound_mode "webhook".
# AKRITAS_TELEGRAM_WEBHOOK_SECRET=
# Optional for polling: without explicit allowlists, only AKRITAS_TELEGRAM_CHAT_ID is accepted.
# AKRITAS_TELEGRAM_ALLOWED_CHAT_IDS=
# AKRITAS_TELEGRAM_ALLOWED_USER_IDS=
# AKRITAS_MATTERMOST_URL=https://mattermost.example
# AKRITAS_MATTERMOST_BOT_TOKEN=
# AKRITAS_MATTERMOST_CHANNEL_ID=
# AKRITAS_MATTERMOST_OUTGOING_WEBHOOK_TOKEN=
# AKRITAS_MATTERMOST_ALLOWED_CHANNEL_IDS=
# AKRITAS_MATTERMOST_ALLOWED_USER_IDS=
# AKRITAS_WORKSPACE_CONFIG=
# AKRITAS_AUDIT_LOG=/var/lib/akritas/audit/akritas.jsonl
# AKRITAS_SEARCH_TOP_K=5
# AKRITAS_RESULT_RUNES=800
# AKRITAS_MAX_TOKENS=1024
# AKRITAS_MAX_TOKENS_LIMIT=4096
# AKRITAS_MAX_TOOL_CALLS=8
# AKRITAS_MAX_ITERATIONS=12
# AKRITAS_MAX_TOOL_RESULT_BYTES=2097152
# AKRITAS_MAX_RETRIEVED_CONTEXT_BYTES=131072
# AKRITAS_MAX_CONTEXT_TOKENS=40000
# AKRITAS_MAX_MODEL_TOKENS=16384
# AKRITAS_TEMPERATURE=0.2
# AKRITAS_REQUEST_TIMEOUT=10m
# AKRITAS_WORKSPACES=
# AKRITAS_CHANGE_VALIDATORS=
