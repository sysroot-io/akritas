table inet application {
    set backend_ipv4 {
        type ipv4_addr
        elements = {
        {%- for backend in pillar.nftables.backend_allowlist %}
            {{ backend.address }},
        {%- endfor %}
        }
    }

    chain output {
        type filter hook output priority 0;
        ip daddr @backend_ipv4 tcp dport 8443 accept
    }
}
